# Copy to `.env.local` (gitignored). Values: Supabase Dashboard → Project Settings → API
# or the Connect dialog.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional alias if the dashboard still labels it “anon”:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Not required for P1.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — glossary “Suggest a term” inbox until admin UI exists (Resend).
# RESEND_API_KEY=
# GLOSSARY_NOTIFY_EMAIL=you@example.com
# RESEND_FROM_EMAIL=SDD Show <notify@yourdomain.com>
